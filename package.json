{
  "name": "paymentchaos-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "pack:private": "node tooling/private-beta.mjs",
    "test:private-package": "node --experimental-strip-types tooling/private-beta-smoke.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
