---
// biome-ignore lint/correctness/noUnusedImports: Astro templates use this value.
import { siteMessages as m } from "../messages.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions use these props.
const { title, description } = Astro.props;
// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions use this URL.
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{m.skipLink}</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label={m.homeLabel}>
        <img src="/brand.svg" alt="" width="29" height="29" />
        {m.productName}
      </a>
      <nav aria-label={m.primaryNav}>
        <a class="nav-wide" href="/#how-it-works">{m.navHowItWorks}</a>
        <a href="/docs/">{m.navDocs}</a>
        <a class="nav-cta" href="/#waitlist">{m.navEarlyAccess}</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{m.footerTagline}</p>
      <nav aria-label={m.footerNav}>
        <a href="/docs/">{m.footerDocs}</a>
        <a href="/privacy/">{m.footerPrivacy}</a>
      </nav>
    </footer>
  </body>
</html>
