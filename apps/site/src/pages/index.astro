---
// biome-ignore lint/correctness/noUnusedImports: Astro templates use this component.
import DeliveryPreview from "../components/DeliveryPreview.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro templates use this value.
import demoTranscript from "../data/demo.txt?raw";
// biome-ignore lint/correctness/noUnusedImports: Astro templates use this value.
import { landingMessages as m } from "../landing-messages.ts";
// biome-ignore lint/correctness/noUnusedImports: Astro templates use this component.
import BaseLayout from "../layouts/BaseLayout.astro";
// biome-ignore lint/correctness/noUnusedImports: Astro templates use these values.
import { siteMessages, waitlistMessages } from "../messages.ts";
import "../styles/landing.css";

// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions use this value.
const loopsFormId = import.meta.env.PUBLIC_LOOPS_FORM_ID?.trim();
// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions use this value.
const loopsDoubleOptIn = import.meta.env.PUBLIC_LOOPS_DOUBLE_OPT_IN?.trim() === "true";
// biome-ignore lint/correctness/noUnusedVariables: Astro template expressions use this value.
const githubUrl = import.meta.env.PUBLIC_GITHUB_URL?.trim();
---

<BaseLayout title={m.title} description={m.description}>
  <section class="shell hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">{m.eyebrow}</p>
      <h1 id="hero-title">{m.heroTitle} <span>{m.heroRest}</span></h1>
      <p class="lede">{m.heroDescription}</p>
      <div class="button-row">
        <a class="button" href="/docs/">{m.ctaDocs} <span aria-hidden="true">↗</span></a>
        <a class="button secondary" href="#demo">{m.ctaDemo} <span aria-hidden="true">↓</span></a>
        {githubUrl && <a class="button secondary" href={githubUrl}>{siteMessages.ctaGithub}</a>}
      </div>
      <p class="hero-note">{m.sourceNote}</p>
    </div>
    <DeliveryPreview />
  </section>

  <div class="shell proof-strip">
    <span>{m.providersLabel}</span>
    {m.providers.map((provider) => <strong>{provider}</strong>)}
    <span>{m.portability}</span>
  </div>

  <section class="shell section" aria-labelledby="failures-title">
    <div class="section-heading">
      <div>
        <p class="section-label">{m.failuresLabel}</p>
        <h2 id="failures-title">{m.failuresTitle}</h2>
      </div>
      <p class="lede">{m.failuresDescription}</p>
    </div>
    <div class="grid">
      {m.failures.map((failure) => (
        <article class="card">
          <span class="number">{failure.label}</span>
          <div class="failure-signal">{failure.signal}</div>
          <h3>{failure.title}</h3>
          <p>{failure.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section" id="demo" aria-labelledby="demo-title">
    <p class="section-label">{m.demoLabel}</p>
    <h2 id="demo-title">{m.demoTitle}</h2>
    <p class="lede">{m.demoDescription}</p>
    <div class="outcomes">
      <article class="outcome fail">
        <strong>{m.naiveLabel}</strong>
        <h3>{m.naiveResult}</h3>
        <p class="quiet">{m.naiveDetail}</p>
      </article>
      <article class="outcome">
        <strong>{m.correctLabel}</strong>
        <h3>{m.correctResult}</h3>
        <p class="quiet">{m.correctDetail}</p>
      </article>
    </div>
    <details class="transcript">
      <summary>{m.transcriptToggle}</summary>
      <p class="hero-note">{m.transcriptNote}</p>
      <div class="terminal">
        <div class="terminal-bar" aria-hidden="true">
          <span>{siteMessages.productName}</span>
          <span>stripe-subscription-renewal</span>
        </div>
        <pre tabindex="0" aria-label={siteMessages.demoLabel}><code>{demoTranscript}</code></pre>
      </div>
    </details>
  </section>

  <section class="shell section" id="how-it-works" aria-labelledby="works-title">
    <p class="section-label">{m.worksLabel}</p>
    <h2 id="works-title">{m.worksTitle}</h2>
    <div class="grid steps">
      {m.steps.map((step, index) => (
        <article class="card">
          <span class="number" aria-hidden="true">0{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="shell section split" aria-labelledby="difference-title">
    <div>
      <p class="section-label">{m.differenceLabel}</p>
      <h2 id="difference-title">{m.differenceTitle}</h2>
      <p class="lede">{m.differenceDescription}</p>
    </div>
    <ul class="comparison">
      {m.differences.map((difference) => (
        <li><h3>{difference.title}</h3><p class="quiet">{difference.description}</p></li>
      ))}
    </ul>
  </section>

  <section class="shell section" id="waitlist" aria-labelledby="waitlist-title">
    <div class="waitlist-panel">
      <div>
      <p class="section-label">{siteMessages.navEarlyAccess}</p>
      <h2 id="waitlist-title">{m.waitlistTitle}</h2>
      <p class="lede">{m.waitlistDescription}</p>
      </div>
      <div>
      {
        loopsFormId ? (
          <>
          <form
            data-waitlist-form
            data-form-id={loopsFormId}
            data-double-opt-in={String(loopsDoubleOptIn)}
            novalidate
            hidden
          >
            <div class="field">
              <label for="waitlist-email">{waitlistMessages.label}</label>
              <div class="field-row">
                <input
                  id="waitlist-email"
                  name="email"
                  type="email"
                  inputmode="email"
                  autocomplete="email"
                  maxlength="254"
                  required
                  aria-describedby="waitlist-consent waitlist-status"
                />
                <button type="submit">{waitlistMessages.button}</button>
              </div>
            </div>
            <p class="consent" id="waitlist-consent">
              {waitlistMessages.consent} <a href="/privacy/">{waitlistMessages.privacyLink}</a>.
            </p>
            <p
              class="form-status"
              id="waitlist-status"
              data-waitlist-status
              data-state="idle"
              role="status"
              aria-live="polite"
              tabindex="-1"
            />
          </form>
          <noscript>
            <p class="notice">{waitlistMessages.noscript}</p>
          </noscript>
          </>
        ) : (
          <p class="notice" role="status">{siteMessages.waitlistUnavailable}</p>
        )
      }
      </div>
    </div>
  </section>

  {
    loopsFormId && (
      <script>
        import { mountWaitlistForm } from "../lib/waitlist.ts";

        const form = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
        const formId = form?.dataset.formId;
        if (form && formId) mountWaitlistForm(form, formId, form.dataset.doubleOptIn === "true");
      </script>
    )
  }
</BaseLayout>
