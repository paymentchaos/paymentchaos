{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string"
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "planHash": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "scenario": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "repeat": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repeatsFailed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "error"
      ]
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "attempt": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "eventType": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "statusCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "latencyMs": {
            "type": "number",
            "minimum": 0
          },
          "error": {
            "type": "string"
          },
          "chaosTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "seq",
          "attempt",
          "eventType",
          "eventId",
          "latencyMs",
          "chaosTags"
        ],
        "additionalProperties": false
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          },
          "expected": {},
          "observed": {},
          "message": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "pass"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "seed",
    "planHash",
    "provider",
    "scenario",
    "startedAt",
    "finishedAt",
    "repeat",
    "repeatsFailed",
    "status",
    "deliveries",
    "assertions"
  ],
  "additionalProperties": false
}
