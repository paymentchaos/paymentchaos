{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "type": "string",
      "minLength": 1
    },
    "flow": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        }
      },
      "additionalProperties": {}
    },
    "target": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "secret": {
          "type": "string",
          "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "beforeEach": {
          "type": "string",
          "minLength": 1
        },
        "afterEach": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "chaos": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "duplicate": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "minLength": 1
                  },
                  "times": {
                    "default": 1,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "event"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "duplicate"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "reorder": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "reorder"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "delay": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "minLength": 1
                  },
                  "byMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "event",
                  "byMs"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "delay"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "concurrent": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "minLength": 1
                  },
                  "deliveries": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "event",
                  "deliveries"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "concurrent"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "assert": {
      "type": "object",
      "properties": {
        "settle": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "intervalMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "timeoutMs",
            "intervalMs"
          ],
          "additionalProperties": false
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "http": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "expect": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "url",
            "expect"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "repeat": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "version",
    "name",
    "provider",
    "flow"
  ],
  "additionalProperties": false
}
