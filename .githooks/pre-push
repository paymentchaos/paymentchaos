#!/bin/sh
# Free private GitHub repositories cannot enforce branch protection, so this hook does it locally.
# Bypass only for the one-time bootstrap push: PAYMENTCHAOS_ALLOW_MAIN_PUSH=1 git push

if [ "$PAYMENTCHAOS_ALLOW_MAIN_PUSH" = "1" ]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are not allowed. Push a branch and open a pull request." >&2
    exit 1
  fi
done

exit 0
